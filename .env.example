# Cyberwolf SIEM local-development configuration.
# Replace both placeholder values before production.
PROJECT_NAME="Cyberwolf SIEM"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=development-only-placeholder-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
POSTGRES_USER=cyberwolf
POSTGRES_PASSWORD=development-only-postgres-password
POSTGRES_DB=cyberwolf_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://cyberwolf:development-only-postgres-password@localhost:5432/cyberwolf_db
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_INGEST="500/minute"
MAX_BATCH_SIZE=100
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
