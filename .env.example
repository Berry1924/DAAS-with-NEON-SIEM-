# Cyberwolf SIEM - Environment Configuration Template
PROJECT_NAME="Cyberwolf SIEM"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=cyberwolf
POSTGRES_PASSWORD=cyberwolf_dev_password
POSTGRES_DB=cyberwolf_db
DATABASE_URL=postgresql://cyberwolf:cyberwolf_dev_password@db:5432/cyberwolf_db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting & Bounds
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_INGEST="500/minute"
MAX_BATCH_SIZE=100
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
