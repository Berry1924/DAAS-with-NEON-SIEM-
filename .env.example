# ============================================================
# NEON SIEM — Environment Configuration
# ============================================================
# Copy this file to .env and replace placeholder values
# before production deployment.
# ============================================================

# Application
PROJECT_NAME="NEON SIEM"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Authentication (MUST change before production)
SECRET_KEY=development-only-placeholder-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo Mode (set to false in production)
DEMO_MODE=true

# PostgreSQL
POSTGRES_USER=cyberwolf
POSTGRES_PASSWORD=development-only-postgres-password
POSTGRES_DB=cyberwolf_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://cyberwolf:YOUR_PASSWORD@localhost:5432/cyberwolf_db

# CORS (JSON array of allowed frontend origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_INGEST="500/minute"

# Request/Pagination Limits
MAX_BATCH_SIZE=100
MAX_REQUEST_BODY_BYTES=1048576
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
